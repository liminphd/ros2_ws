<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amiga_gazebo_sim">

  
  
  

  
  

  <xacro:property name="wheelbase" value="1.07" />
  <xacro:property name="track_width" value="0.55" />
  <xacro:property name="wheel_radius" value="0.22" />
  <xacro:property name="wheel_width" value="0.11" />

  
  <xacro:property name="base_length" value="1.41" />
  <xacro:property name="base_width" value="0.80" />
  <xacro:property name="base_height" value="0.20" />


  
  
  

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0" />
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0" />
  </material>


  
  
  

  <link name="base_footprint" />

  <link name="base_link">

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}" />
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="20.0" />

      
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="2.5" iyz="0.0" izz="3.0" />
    </inertial>

  <visual name="left_frame_rail"><origin xyz="0 0.31 -0.12" rpy="0 0 0" /><geometry><box size="1.35 0.06 0.08" /></geometry><material name="left_frame_rail_material"><color rgba="0.55 0.59 0.62 1" /></material></visual><visual name="right_frame_rail"><origin xyz="0 -0.31 -0.12" rpy="0 0 0" /><geometry><box size="1.35 0.06 0.08" /></geometry><material name="right_frame_rail_material"><color rgba="0.55 0.59 0.62 1" /></material></visual><visual name="front_crossmember"><origin xyz="0.6 0 -0.12" rpy="0 0 0" /><geometry><box size="0.07 0.68 0.08" /></geometry><material name="front_crossmember_material"><color rgba="0.55 0.59 0.62 1" /></material></visual><visual name="rear_crossmember"><origin xyz="-0.6 0 -0.12" rpy="0 0 0" /><geometry><box size="0.07 0.68 0.08" /></geometry><material name="rear_crossmember_material"><color rgba="0.55 0.59 0.62 1" /></material></visual><visual name="equipment_plate"><origin xyz="0 0 -0.08" rpy="0 0 0" /><geometry><box size="0.55 0.48 0.04" /></geometry><material name="equipment_plate_material"><color rgba="0.16 0.19 0.21 1" /></material></visual><visual name="front_aluminum_mast"><origin xyz="0.64 0 0.27" rpy="0 0 0" /><geometry><box size="0.045 0.045 0.78" /></geometry><material name="front_aluminum_mast_material"><color rgba="0.65 0.68 0.70 1" /></material></visual><visual name="rear_aluminum_mast"><origin xyz="-0.64 0 0.27" rpy="0 0 0" /><geometry><box size="0.045 0.045 0.78" /></geometry><material name="rear_aluminum_mast_material"><color rgba="0.65 0.68 0.70 1" /></material></visual><visual name="front_camera_bracket"><origin xyz="0.715 0 0.55" rpy="0 0 0" /><geometry><box size="0.15 0.035 0.035" /></geometry><material name="front_camera_bracket_material"><color rgba="0.65 0.68 0.70 1" /></material></visual><visual name="rear_camera_bracket"><origin xyz="-0.715 0 0.55" rpy="0 0 0" /><geometry><box size="0.15 0.035 0.035" /></geometry><material name="rear_camera_bracket_material"><color rgba="0.65 0.68 0.70 1" /></material></visual><visual name="white_gnss_support"><origin xyz="0.48 0 0.255" rpy="0 0 0" /><geometry><box size="0.035 0.035 0.75" /></geometry><material name="white_gnss_support_silver"><color rgba="0.65 0.68 0.70 1" /></material></visual><visual name="lidar_support_column"><origin xyz="0.680 0.150 0.047" rpy="0 0 0" /><geometry><box size="0.035 0.035 0.254" /></geometry><material name="lidar_support_column_material"><color rgba="0.65 0.68 0.70 1" /></material></visual><visual name="lidar_mounting_plate"><origin xyz="0.680 0.150 0.168" rpy="0 0 0" /><geometry><box size="0.120 0.120 0.012" /></geometry><material name="lidar_mounting_plate_material"><color rgba="0.20 0.22 0.24 1" /></material></visual><visual name="brain_display_support"><origin xyz="0.48 -0.05 0.34" rpy="0 0 0" /><geometry><box size="0.03 0.10 0.03" /></geometry><material name="brain_display_support_material"><color rgba="0.65 0.68 0.70 1" /></material></visual><visual name="brain_display_housing"><origin xyz="0.48 -0.115 0.34" rpy="0 0 0" /><geometry><box size="0.24 0.03 0.16" /></geometry><material name="brain_display_housing_material"><color rgba="0.12 0.13 0.15 1" /></material></visual><visual name="brain_display_screen"><origin xyz="0.48 -0.132 0.34" rpy="0 0 0" /><geometry><box size="0.21 0.003 0.13" /></geometry><material name="brain_display_screen_material"><color rgba="0.08 0.18 0.24 1" /></material></visual><visual name="arm_mount_base"><origin xyz="-0.050000 0.270000 -0.025000" rpy="0.000000 0.000000 0.000000" /><geometry><cylinder radius="0.115" length="0.07" /></geometry><material name="arm_mount_base_material"><color rgba="0.12 0.13 0.15 1" /></material></visual><visual name="arm_rotating_pedestal"><origin xyz="-0.050000 0.270000 0.070000" rpy="0.000000 0.000000 0.000000" /><geometry><cylinder radius="0.075" length="0.12" /></geometry><material name="arm_rotating_pedestal_material"><color rgba="0.95 0.38 0.08 1" /></material></visual><visual name="arm_upper_link"><origin xyz="-0.120000 0.270000 0.310000" rpy="0.000000 0.370891 3.141593" /><geometry><cylinder radius="0.055" length="0.3862641583165593" /></geometry><material name="arm_upper_link_material"><color rgba="0.82 0.84 0.84 1" /></material></visual><visual name="arm_elbow_joint"><origin xyz="-0.190000 0.270000 0.490000" rpy="1.570796 0.000000 0.000000" /><geometry><cylinder radius="0.068" length="0.12" /></geometry><material name="arm_elbow_joint_material"><color rgba="0.05 0.06 0.07 1" /></material></visual><visual name="arm_forearm_link"><origin xyz="-0.085000 0.270000 0.590000" rpy="0.000000 0.809784 0.000000" /><geometry><cylinder radius="0.042" length="0.29" /></geometry><material name="arm_forearm_link_material"><color rgba="0.82 0.84 0.84 1" /></material></visual><visual name="arm_wrist_joint"><origin xyz="0.020000 0.270000 0.690000" rpy="1.570796 0.000000 0.000000" /><geometry><cylinder radius="0.045" length="0.1" /></geometry><material name="arm_wrist_joint_material"><color rgba="0.95 0.38 0.08 1" /></material></visual><visual name="arm_gripper_body"><origin xyz="0.075000 0.270000 0.700000" rpy="0.000000 0.000000 0.000000" /><geometry><box size="0.1 0.075 0.055" /></geometry><material name="arm_gripper_body_material"><color rgba="0.12 0.13 0.15 1" /></material></visual><visual name="arm_gripper_left_finger"><origin xyz="0.150000 0.315000 0.700000" rpy="0.000000 0.000000 0.000000" /><geometry><box size="0.095 0.018 0.025" /></geometry><material name="arm_gripper_left_finger_material"><color rgba="0.65 0.68 0.70 1" /></material></visual><visual name="arm_gripper_right_finger"><origin xyz="0.150000 0.225000 0.700000" rpy="0.000000 0.000000 0.000000" /><geometry><box size="0.095 0.018 0.025" /></geometry><material name="arm_gripper_right_finger_material"><color rgba="0.65 0.68 0.70 1" /></material></visual><visual name="remote_mount"><origin xyz="0.480000 -0.255000 0.125000" rpy="0.000000 0.000000 0.000000" /><geometry><box size="0.1 0.13 0.035" /></geometry><material name="remote_mount_material"><color rgba="0.65 0.68 0.70 1" /></material></visual><visual name="remote_body"><origin xyz="0.480000 -0.285000 0.205000" rpy="0.000000 0.000000 0.000000" /><geometry><box size="0.2 0.12 0.13" /></geometry><material name="remote_body_material"><color rgba="0.05 0.06 0.07 1" /></material></visual><visual name="remote_small_screen"><origin xyz="0.480000 -0.349000 0.235000" rpy="0.000000 0.000000 0.000000" /><geometry><box size="0.145 0.004 0.07" /></geometry><material name="remote_small_screen_material"><color rgba="0.07 0.22 0.28 1" /></material></visual><visual name="remote_handle"><origin xyz="0.480000 -0.285000 0.095000" rpy="0.000000 0.000000 0.000000" /><geometry><box size="0.055 0.055 0.13" /></geometry><material name="remote_handle_material"><color rgba="0.12 0.13 0.15 1" /></material></visual><visual name="remote_joystick"><origin xyz="0.545000 -0.352000 0.175000" rpy="1.570796 0.000000 0.000000" /><geometry><cylinder radius="0.014" length="0.045" /></geometry><material name="remote_joystick_material"><color rgba="0.95 0.38 0.08 1" /></material></visual><visual name="lidar_frame_connector"><origin xyz="0.645000 0.150000 -0.105000" rpy="0.000000 0.000000 0.000000" /><geometry><box size="0.105 0.045 0.035" /></geometry><material name="lidar_frame_connector_material"><color rgba="0.65 0.68 0.70 1" /></material></visual></link>


  

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link" />
    <child link="base_footprint" />
    <origin xyz="0 0 -0.715" rpy="0 0 0" />
  </joint>


  
  
  

  

  <xacro:macro name="wheel" params="prefix x y">

    <link name="${prefix}_wheel_link">

      <visual>
        
        <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="black" />
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="2.0" />

        
        <inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.03" />
      </inertial>

    </link>


    

    <joint name="${prefix}_wheel_joint" type="continuous">

      <parent link="base_link" />
      <child link="${prefix}_wheel_link" />

      <origin xyz="${x} ${y} -0.495" rpy="0 0 0" />
      <axis xyz="0 1 0" />


    </joint>

  </xacro:macro>


  
  
  

  

  <xacro:wheel prefix="front_left" x="${wheelbase / 2.0}" y="${track_width / 2.0}" />

  <xacro:wheel prefix="front_right" x="${wheelbase / 2.0}" y="${-track_width / 2.0}" />

  <xacro:wheel prefix="rear_left" x="${-wheelbase / 2.0}" y="${track_width / 2.0}" />

  <xacro:wheel prefix="rear_right" x="${-wheelbase / 2.0}" y="${-track_width / 2.0}" />


  
  
  

  

  <link name="front_camera_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.115 0.025" />
      </geometry>
      <material name="black" />
    </visual>

  </link>

  <joint name="front_camera_joint" type="fixed">

    <parent link="base_link" />
    <child link="front_camera_link" />

    <origin xyz="0.79 0 0.58" rpy="0 0.2618 0" />

  </joint>


  
  
  

  

  <link name="front_camera_right_frame" />

  <joint name="front_camera_right_joint" type="fixed">

    <parent link="front_camera_link" />
    <child link="front_camera_right_frame" />

    <origin xyz="0.0002830922 -0.0376089215 -0.0001362767" rpy="0.01093888 -0.01895032 0.00408157" />

  </joint>


  
  
  

  

  <link name="front_camera_right_optical_frame" />

  <joint name="front_camera_right_optical_joint" type="fixed">

    <parent link="front_camera_right_frame" />
    <child link="front_camera_right_optical_frame" />

    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679" />

  </joint>


  
  
  

  

  <link name="front_camera_depth_optical_frame" />

  <joint name="front_camera_depth_optical_joint" type="fixed">

    <parent link="front_camera_right_optical_frame" />
    <child link="front_camera_depth_optical_frame" />

    <origin xyz="0 0 0" rpy="0.00138700 -0.01342679 -0.00183043" />

  </joint>


  
  
  

  

  <link name="rear_camera_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.115 0.025" />
      </geometry>
      <material name="black" />
    </visual>

  </link>

  <joint name="rear_camera_joint" type="fixed">

    <parent link="base_link" />
    <child link="rear_camera_link" />

    <origin xyz="-0.79 0 0.58" rpy="0 0.2618 3.14159" />

  </joint>
  
  
  

  

  <link name="rear_camera_right_frame" />

  <joint name="rear_camera_right_joint" type="fixed">

    <parent link="rear_camera_link" />
    <child link="rear_camera_right_frame" />

    <origin xyz="-0.000351802 -0.037616639 -0.000164001" rpy="0.04121807 -0.00155343 -0.03745893" />

  </joint>


  
  
  

  

  <link name="rear_camera_right_optical_frame" />

  <joint name="rear_camera_right_optical_joint" type="fixed">

    <parent link="rear_camera_right_frame" />
    <child link="rear_camera_right_optical_frame" />

    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679" />

  </joint>


  
  
  

  

  <link name="rear_camera_depth_optical_frame" />

  <joint name="rear_camera_depth_optical_joint" type="fixed">

    <parent link="rear_camera_right_optical_frame" />
    <child link="rear_camera_depth_optical_frame" />

    <origin xyz="0 0 0" rpy="-0.00022543 -0.02808973 -0.00469591" />

  </joint>

  
  
  

  

  <link name="imu_link" />

  <joint name="imu_joint" type="fixed">

    <parent link="base_link" />
    <child link="imu_link" />

    <origin xyz="0 0 0" rpy="0 0 0" />

  </joint>


  
  
  

  

  <link name="gps_link"><visual name="primary_gnss_antenna"><origin xyz="0 0 0" rpy="0 0 0" /><geometry><cylinder radius="0.055" length="0.025" /></geometry><material name="primary_gnss_antenna_material"><color rgba="0.75 0.12 0.10 1" /></material></visual></link>

  <joint name="gps_joint" type="fixed">

    <parent link="base_link" />
    <child link="gps_link" />

    <origin xyz="0.640 0 0.685" rpy="0 0 0" />

  </joint>


  
  
  

  

  <link name="white_gnss_link"><visual name="white_gnss_antenna"><origin xyz="0 0 0" rpy="0 0 0" /><geometry><cylinder radius="0.055" length="0.025" /></geometry><material name="white_gnss_antenna_material"><color rgba="0.92 0.92 0.88 1" /></material></visual></link>

  <joint name="white_gnss_joint" type="fixed">

    <parent link="base_link" />
    <child link="white_gnss_link" />

    <origin xyz="0.480 0 0.645" rpy="0 0 0" />

  </joint>


  
  
  

  

  <link name="velodyne"><visual name="vlp16_body"><origin xyz="0 0 0" rpy="0 0 0" /><geometry><cylinder radius="0.0515" length="0.072" /></geometry><material name="vlp16_black"><color rgba="0.08 0.08 0.09 1" /></material></visual></link>

  <joint name="velodyne_joint" type="fixed">

    <parent link="base_link" />
    <child link="velodyne" />

    <origin xyz="0.680 0.150 0.210" rpy="0 0 -1.228" />

  </joint>




  
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">

      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>

      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <wheel_separation>0.55</wheel_separation>
      <wheel_radius>0.22</wheel_radius>

      <topic>/model/amiga/cmd_vel</topic>
      <odom_topic>/model/amiga/odometry</odom_topic>

      <max_linear_velocity>0.5</max_linear_velocity>
      <max_angular_velocity>0.5</max_angular_velocity>
    </plugin>
  </gazebo>

<link name="gps_secondary_link"><visual name="rear_sbg_antenna"><origin xyz="0 0 0" rpy="0 0 0" /><geometry><cylinder radius="0.055" length="0.025" /></geometry><material name="rear_sbg_antenna_material"><color rgba="0.75 0.12 0.10 1" /></material></visual></link><joint name="gps_secondary_joint" type="fixed"><parent link="base_link" /><child link="gps_secondary_link" /><origin xyz="-0.640 0 0.685" rpy="0 0 0" /></joint></robot>