<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="agricultural_skid_steer_robot">

  <!-- ====================================================== -->
  <!-- Robot geometry parameters                              -->
  <!-- ====================================================== -->

  <!-- Current measured geometry -->
  <!-- Track width may be updated after chassis modification -->

  <xacro:property name="wheelbase" value="1.07"/>
  <xacro:property name="track_width" value="0.55"/>
  <xacro:property name="wheel_radius" value="0.22"/>
  <xacro:property name="wheel_width" value="0.11"/>

  <!--
    Temporary chassis visualization dimensions.
    These are NOT the skid-steer kinematic dimensions.
    Update after final mechanical modification.
  -->
  <xacro:property name="base_length" value="1.41"/>
  <xacro:property name="base_width" value="0.80"/>
  <xacro:property name="base_height" value="0.20"/>


  <!-- ====================================================== -->
  <!-- Materials                                              -->
  <!-- ====================================================== -->

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>


  <!-- ====================================================== -->
  <!-- Base frames                                            -->
  <!-- ====================================================== -->

  <link name="base_footprint"/>

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="20.0"/>

      <!-- Temporary inertia values -->
      <inertia
        ixx="1.0"
        ixy="0.0"
        ixz="0.0"
        iyy="2.5"
        iyz="0.0"
        izz="3.0"/>
    </inertial>

  </link>


  <!--
    Coordinate convention:
      X = forward
      Y = left
      Z = up

    base_link origin is defined at the geometric center
    of the SBG IMU.

    Measured SBG center height above ground:
      0.715 m
  -->

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 -0.715" rpy="0 0 0"/>
  </joint>


  <!-- ====================================================== -->
  <!-- Wheel macro                                            -->
  <!-- ====================================================== -->

  <!--
    Four-wheel skid-steer configuration.

    IMPORTANT:
    The wheels do NOT steer around the Z axis.
    Steering is generated by differential velocity between
    the left and right wheel groups.
  -->

  <xacro:macro name="wheel" params="prefix x y">

    <link name="${prefix}_wheel_link">

      <visual>
        <!-- Cylinder axis converted to wheel axle direction -->
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="2.0"/>

        <!-- Approximate wheel inertia -->
        <inertia
          ixx="0.03"
          ixy="0.0"
          ixz="0.0"
          iyy="0.05"
          iyz="0.0"
          izz="0.03"/>
      </inertial>

    </link>


    <!--
      Wheel has ONLY rolling rotation.
      No steering joint is present.
    -->

    <joint name="${prefix}_wheel_joint" type="fixed">

      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>

      <origin
        xyz="${x} ${y} 0"
        rpy="0 0 0"/>


    </joint>

  </xacro:macro>


  <!-- ====================================================== -->
  <!-- Four wheels                                            -->
  <!-- ====================================================== -->

  <!--
    wheelbase   = 1.07 m  -> +/- 0.535 m
    track_width = 0.55 m  -> +/- 0.275 m
  -->

  <xacro:wheel
    prefix="front_left"
    x="${wheelbase / 2.0}"
    y="${track_width / 2.0}"/>

  <xacro:wheel
    prefix="front_right"
    x="${wheelbase / 2.0}"
    y="${-track_width / 2.0}"/>

  <xacro:wheel
    prefix="rear_left"
    x="${-wheelbase / 2.0}"
    y="${track_width / 2.0}"/>

  <xacro:wheel
    prefix="rear_right"
    x="${-wheelbase / 2.0}"
    y="${-track_width / 2.0}"/>


  <!-- ====================================================== -->
  <!-- Front OAK camera                                      -->
  <!-- ====================================================== -->

  <!--
    Front OAK mechanical mounting frame.

    Coordinate convention:
      X = robot forward
      Y = robot left
      Z = robot up

    Measured mounting position relative to base_link:
      X = +0.790 m
      Y =  0.000 m
      Z = +0.580 m

    Camera is pitched approximately 15 degrees downward.

    IMPORTANT:
    front_camera_link represents the mechanical/base frame of the
    complete OAK camera. Internal optical frames below are derived
    from the factory EEPROM calibration of OAK0.

    Front OAK0:
      MXID: 14442C1071C4CDD200
  -->

  <link name="front_camera_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.115 0.025"/>
      </geometry>
      <material name="black"/>
    </visual>

  </link>

  <joint name="front_camera_joint" type="fixed">

    <parent link="base_link"/>
    <child link="front_camera_link"/>

    <origin
      xyz="0.79 0 0.58"
      rpy="0 0.2618 0"/>

  </joint>


  <!-- ====================================================== -->
  <!-- Front OAK RIGHT physical camera frame                  -->
  <!-- ====================================================== -->

  <!--
    The current Brain-side StereoDepth pipeline uses:

      LEFT  = CAM_B / socket 1
      RIGHT = CAM_C / socket 2

    StereoDepth depthAlign is RECTIFIED_RIGHT.

    The RIGHT-camera transform below is derived from the
    OAK0 factory EEPROM calibration and converted using the
    same DepthAI ROS coordinate conversion used by the
    official Luxonis ROS TF publisher.

    EEPROM RIGHT -> RGB translation [cm]:
      [3.76089215, 0.013627666, 0.028309220]

    Converted ROS translation [m]:
      X = +0.0002830922
      Y = -0.0376089215
      Z = -0.0001362767

    Converted ROS rotation [rad]:
      roll  = +0.01093888
      pitch = -0.01895032
      yaw   = +0.00408157
  -->

  <link name="front_camera_right_frame"/>

  <joint name="front_camera_right_joint" type="fixed">

    <parent link="front_camera_link"/>
    <child link="front_camera_right_frame"/>

    <origin
      xyz="0.0002830922 -0.0376089215 -0.0001362767"
      rpy="0.01093888 -0.01895032 0.00408157"/>

  </joint>


  <!-- ====================================================== -->
  <!-- Front OAK RIGHT optical frame                          -->
  <!-- ====================================================== -->

  <!--
    Standard ROS optical-frame convention:

      +X = image right
      +Y = image down
      +Z = optical forward

    Rotation is equivalent to the optical transform used by
    the Luxonis ROS TF publisher:

      quaternion (x,y,z,w)
        = (-0.5, +0.5, -0.5, +0.5)

    Equivalent RPY:
      roll  = -pi/2
      pitch = 0
      yaw   = -pi/2
  -->

  <link name="front_camera_right_optical_frame"/>

  <joint name="front_camera_right_optical_joint" type="fixed">

    <parent link="front_camera_right_frame"/>
    <child link="front_camera_right_optical_frame"/>

    <origin
      xyz="0 0 0"
      rpy="-1.57079632679 0 -1.57079632679"/>

  </joint>


  <!-- ====================================================== -->
  <!-- Front OAK rectified RIGHT depth optical frame          -->
  <!-- ====================================================== -->

  <!--
    The Brain StereoDepth pipeline does NOT publish depth in the
    unrectified physical RIGHT optical frame.

    StereoDepth configuration:
      depthAlign = RECTIFIED_RIGHT

    Factory EEPROM rectifiedRotationRight:

      [ 0.999908209  -0.001830261   0.013426391 ]
      [ 0.001811802   0.999997377   0.001386874 ]
      [-0.013428895  -0.001362421   0.999908924 ]

    The TF below represents the rectified-right optical frame
    relative to the physical right optical frame.

    This frame is the coordinate frame used by:

      /camera/front/depth/image_raw
      /camera/front/depth/camera_info
      /camera/front/depth/points

    and MUST match the frame_id published by farmng_depth_bridge.
  -->

  <link name="front_camera_depth_optical_frame"/>

  <joint name="front_camera_depth_optical_joint" type="fixed">

    <parent link="front_camera_right_optical_frame"/>
    <child link="front_camera_depth_optical_frame"/>

    <origin
      xyz="0 0 0"
      rpy="0.00138700 -0.01342679 -0.00183043"/>

  </joint>


  <!-- ====================================================== -->
  <!-- Rear OAK camera                                       -->
  <!-- ====================================================== -->

  <!--
    Rear OAK mechanical mounting frame.

    Position and approximately 15 degree downward tilt are based
    on the current mechanical installation.

    The rear camera is required for near-field obstacle perception
    during reversing and turning.

    Its internal calibrated optical/depth frames will be added from
    the REAR OAK EEPROM calibration; front-camera calibration values
    must NOT be reused here.
  -->

  <link name="rear_camera_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.115 0.025"/>
      </geometry>
      <material name="black"/>
    </visual>

  </link>

  <joint name="rear_camera_joint" type="fixed">

    <parent link="base_link"/>
    <child link="rear_camera_link"/>

    <origin
      xyz="-0.79 0 0.58"
      rpy="0 0.2618 3.14159"/>

  </joint>
  <!-- ====================================================== -->
  <!-- Rear OAK RIGHT physical camera frame                   -->
  <!-- ====================================================== -->

  <!--
    Rear OAK1 factory calibration.

    Rear OAK1:
      MXID: 14442C10A1B3E6D200

    The Brain-side StereoDepth pipeline uses:

      LEFT  = CAM_B / socket 1
      RIGHT = CAM_C / socket 2

    StereoDepth depthAlign = RECTIFIED_RIGHT.

    EEPROM RIGHT -> RGB translation [cm]:
      [3.761663914, 0.016400071, -0.035180192]

    Converted ROS translation [m]:
      X = -0.000351802
      Y = -0.037616639
      Z = -0.000164001

    Converted ROS rotation [rad]:
      roll  = +0.04121807
      pitch = -0.00155343
      yaw   = -0.03745893
  -->

  <link name="rear_camera_right_frame"/>

  <joint name="rear_camera_right_joint" type="fixed">

    <parent link="rear_camera_link"/>
    <child link="rear_camera_right_frame"/>

    <origin
      xyz="-0.000351802 -0.037616639 -0.000164001"
      rpy="0.04121807 -0.00155343 -0.03745893"/>

  </joint>


  <!-- ====================================================== -->
  <!-- Rear OAK RIGHT optical frame                           -->
  <!-- ====================================================== -->

  <!--
    Standard ROS optical-frame convention:

      +X = image right
      +Y = image down
      +Z = optical forward

    Luxonis ROS optical transform:

      quaternion (x,y,z,w)
        = (-0.5, +0.5, -0.5, +0.5)

    Equivalent RPY:
      roll  = -pi/2
      pitch = 0
      yaw   = -pi/2
  -->

  <link name="rear_camera_right_optical_frame"/>

  <joint name="rear_camera_right_optical_joint" type="fixed">

    <parent link="rear_camera_right_frame"/>
    <child link="rear_camera_right_optical_frame"/>

    <origin
      xyz="0 0 0"
      rpy="-1.57079632679 0 -1.57079632679"/>

  </joint>


  <!-- ====================================================== -->
  <!-- Rear OAK rectified RIGHT depth optical frame           -->
  <!-- ====================================================== -->

  <!--
    Factory EEPROM rectifiedRotationRight:

      [ 0.999594510  -0.004694043   0.028086038 ]
      [ 0.004702227   0.999988914  -0.000225337 ]
      [-0.028084669   0.000357313   0.999605477 ]

    The transform below represents the RECTIFIED_RIGHT depth
    optical frame used by the rear StereoDepth output.

    Future ROS topics:

      /camera/rear/depth/image_raw
      /camera/rear/depth/camera_info
      /camera/rear/depth/points
  -->

  <link name="rear_camera_depth_optical_frame"/>

  <joint name="rear_camera_depth_optical_joint" type="fixed">

    <parent link="rear_camera_right_optical_frame"/>
    <child link="rear_camera_depth_optical_frame"/>

    <origin
      xyz="0 0 0"
      rpy="-0.00022543 -0.02808973 -0.00469591"/>

  </joint>

  <!-- ====================================================== -->
  <!-- SBG IMU frame                                          -->
  <!-- ====================================================== -->

  <!--
    base_link is defined at the SBG IMU geometric center.
    Therefore imu_link is coincident with base_link.
  -->

  <link name="imu_link"/>

  <joint name="imu_joint" type="fixed">

    <parent link="base_link"/>
    <child link="imu_link"/>

    <origin
      xyz="0 0 0"
      rpy="0 0 0"/>

  </joint>


  <!-- ====================================================== -->
  <!-- SBG GNSS primary antenna ANT1                          -->
  <!-- ====================================================== -->

  <!--
    ANT1 / Primary GNSS antenna relative to the SBG center:

      X = +0.640 m forward
      Y =  0.000 m
      Z = +0.685 m upward

    ROS frame convention:
      X forward, Y left, Z up
  -->

  <link name="gps_link"/>

  <joint name="gps_joint" type="fixed">

    <parent link="base_link"/>
    <child link="gps_link"/>

    <origin
      xyz="0.640 0 0.685"
      rpy="0 0 0"/>

  </joint>


  <!-- ====================================================== -->
  <!-- Independent white GNSS antenna                         -->
  <!-- ====================================================== -->

  <!--
    Farm-ng white GNSS antenna relative to SBG/base_link:

      X = +0.480 m
      Y =  0.000 m
      Z = +0.645 m
  -->

  <link name="white_gnss_link"/>

  <joint name="white_gnss_joint" type="fixed">

    <parent link="base_link"/>
    <child link="white_gnss_link"/>

    <origin
      xyz="0.480 0 0.645"
      rpy="0 0 0"/>

  </joint>


  <!-- ====================================================== -->
  <!-- Velodyne VLP-16                                        -->
  <!-- ====================================================== -->

  <!--
    Velodyne center relative to SBG/base_link:

      X = +0.680 m
      Y = +0.150 m
      Z = +0.210 m

    Positive Y is robot left side.
  -->

  <link name="velodyne"/>

  <joint name="velodyne_joint" type="fixed">

    <parent link="base_link"/>
    <child link="velodyne"/>

    <origin
      xyz="0.680 0.150 0.210"
      rpy="0 0 -1.228"/>

  </joint>



</robot>
