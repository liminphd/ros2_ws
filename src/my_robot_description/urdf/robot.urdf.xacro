<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="four_wheel_robot">

  <!-- 颜色 -->
  <material name="blue">
    <color rgba="0.1 0.4 0.8 1.0"/>
  </material>  

  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <!-- 地面参考坐标系 -->
  <link name="base_footprint"/>

  <!-- 机器人底盘 -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.65 0.20"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.65 0.20"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia
        ixx="0.7708"
        ixy="0.0"
        ixz="0.0"
        iyy="1.7333"
        iyz="0.0"
        izz="2.4375"/>
    </inertial>
  </link>

  <!-- 把底盘安装在地面参考坐标系上方 -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
  </joint>
  <!-- 四轮独立转向组件 -->
  <xacro:macro name="wheel_assembly" params="prefix x y">

    <!-- 转向架 -->
    <link name="${prefix}_steering_link"/>

    <!-- 转向关节：绕Z轴旋转 -->
    <joint name="${prefix}_steering_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_steering_link"/>
      <origin xyz="${x} ${y} -0.10" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.5708"
             upper="1.5708"
             effort="30.0"
             velocity="1.5"/>
    </joint>

    <!-- 车轮 -->
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.15" length="0.08"/>
        </geometry>
        <material name="black"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.15" length="0.08"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="2.0"/>
        <inertia
          ixx="0.0123"
          ixy="0.0"
          ixz="0.0"
          iyy="0.0225"
          iyz="0.0"
          izz="0.0123"/>
      </inertial>
    </link>

    <!-- 车轮绕Y轴滚动 -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_steering_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

  </xacro:macro>

  <!-- 前左、前右、后左、后右 -->
  <xacro:wheel_assembly prefix="front_left"  x="0.38"  y="0.365"/>
  <xacro:wheel_assembly prefix="front_right" x="0.38"  y="-0.365"/>
  <xacro:wheel_assembly prefix="rear_left"   x="-0.38" y="0.365"/>
  <xacro:wheel_assembly prefix="rear_right"  x="-0.38" y="-0.365"/>
    <!-- Gemini 335 深度相机 -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.115 0.025"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.115 0.025"/>
      </geometry>
    </collision>
  </link>

  <!-- 相机安装在底盘前上方 -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.30 0 0.13" rpy="0 0 0"/>
  </joint>
  </robot>