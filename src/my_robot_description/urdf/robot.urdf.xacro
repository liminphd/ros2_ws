<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="agricultural_skid_steer_robot">

  <!-- ====================================================== -->
  <!-- Robot geometry parameters                              -->
  <!-- ====================================================== -->

  <!-- Current measured geometry -->
  <!-- Track width may be updated after chassis modification -->

  <xacro:property name="wheelbase" value="1.07"/>
  <xacro:property name="track_width" value="0.55"/>
  <xacro:property name="wheel_radius" value="0.22"/>
  <xacro:property name="wheel_width" value="0.11"/>

  <!--
    Temporary chassis visualization dimensions.
    These are NOT the skid-steer kinematic dimensions.
    Update after final mechanical modification.
  -->
  <xacro:property name="base_length" value="1.20"/>
  <xacro:property name="base_width" value="0.50"/>
  <xacro:property name="base_height" value="0.20"/>


  <!-- ====================================================== -->
  <!-- Materials                                              -->
  <!-- ====================================================== -->

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>


  <!-- ====================================================== -->
  <!-- Base frames                                            -->
  <!-- ====================================================== -->

  <link name="base_footprint"/>

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="20.0"/>

      <!-- Temporary inertia values -->
      <inertia
        ixx="1.0"
        ixy="0.0"
        ixz="0.0"
        iyy="2.5"
        iyz="0.0"
        izz="3.0"/>
    </inertial>

  </link>


  <!--
    base_link origin is approximately at the chassis geometric center.
    With a 0.22 m wheel radius and 0.20 m chassis height,
    this temporary height places the wheels near the ground plane.
  -->

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.22" rpy="0 0 0"/>
  </joint>


  <!-- ====================================================== -->
  <!-- Wheel macro                                            -->
  <!-- ====================================================== -->

  <!--
    Four-wheel skid-steer configuration.

    IMPORTANT:
    The wheels do NOT steer around the Z axis.
    Steering is generated by differential velocity between
    the left and right wheel groups.
  -->

  <xacro:macro name="wheel" params="prefix x y">

    <link name="${prefix}_wheel_link">

      <visual>
        <!-- Cylinder axis converted to wheel axle direction -->
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="2.0"/>

        <!-- Approximate wheel inertia -->
        <inertia
          ixx="0.03"
          ixy="0.0"
          ixz="0.0"
          iyy="0.05"
          iyz="0.0"
          izz="0.03"/>
      </inertial>

    </link>


    <!--
      Wheel has ONLY rolling rotation.
      No steering joint is present.
    -->

    <joint name="${prefix}_wheel_joint" type="continuous">

      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>

      <origin
        xyz="${x} ${y} 0"
        rpy="0 0 0"/>

      <axis xyz="0 1 0"/>

    </joint>

  </xacro:macro>


  <!-- ====================================================== -->
  <!-- Four wheels                                            -->
  <!-- ====================================================== -->

  <!--
    wheelbase   = 1.07 m  -> +/- 0.535 m
    track_width = 0.55 m  -> +/- 0.275 m
  -->

  <xacro:wheel
    prefix="front_left"
    x="${wheelbase / 2.0}"
    y="${track_width / 2.0}"/>

  <xacro:wheel
    prefix="front_right"
    x="${wheelbase / 2.0}"
    y="${-track_width / 2.0}"/>

  <xacro:wheel
    prefix="rear_left"
    x="${-wheelbase / 2.0}"
    y="${track_width / 2.0}"/>

  <xacro:wheel
    prefix="rear_right"
    x="${-wheelbase / 2.0}"
    y="${-track_width / 2.0}"/>


  <!-- ====================================================== -->
  <!-- Camera frame                                           -->
  <!-- ====================================================== -->

  <!--
    Existing temporary camera transform.
    Update later using actual measured sensor mounting position.
  -->

  <link name="camera_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.115 0.025"/>
      </geometry>
      <material name="black"/>
    </visual>

  </link>

  <joint name="camera_joint" type="fixed">

    <parent link="base_link"/>
    <child link="camera_link"/>

    <origin
      xyz="0.30 0 0.13"
      rpy="0 0 0"/>

  </joint>


  <!-- ====================================================== -->
  <!-- SBG IMU frame                                          -->
  <!-- ====================================================== -->

  <!--
    TEMPORARY extrinsic transform.
    Measure actual SBG position/orientation before localization
    experiments.
  -->

  <link name="imu_link"/>

  <joint name="imu_joint" type="fixed">

    <parent link="base_link"/>
    <child link="imu_link"/>

    <origin
      xyz="0 0 0"
      rpy="0 0 0"/>

  </joint>


  <!-- ====================================================== -->
  <!-- GNSS main antenna frame                                -->
  <!-- ====================================================== -->

  <!--
    TEMPORARY extrinsic transform.
    Replace with measured main antenna phase-center position.
  -->

  <link name="gps_link"/>

  <joint name="gps_joint" type="fixed">

    <parent link="base_link"/>
    <child link="gps_link"/>

    <origin
      xyz="0 0 0"
      rpy="0 0 0"/>

  </joint>


</robot>