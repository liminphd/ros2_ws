<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="agricultural_skid_steer_robot">

  <!-- ====================================================== -->
  <!-- Robot geometry parameters                              -->
  <!-- ====================================================== -->

  <!-- Current measured geometry -->
  <!-- Track width may be updated after chassis modification -->

  <xacro:property name="wheelbase" value="1.07"/>
  <xacro:property name="track_width" value="0.55"/>
  <xacro:property name="wheel_radius" value="0.22"/>
  <xacro:property name="wheel_width" value="0.11"/>

  <!--
    Temporary chassis visualization dimensions.
    These are NOT the skid-steer kinematic dimensions.
    Update after final mechanical modification.
  -->
  <xacro:property name="base_length" value="1.41"/>
  <xacro:property name="base_width" value="0.80"/>
  <xacro:property name="base_height" value="0.20"/>


  <!-- ====================================================== -->
  <!-- Materials                                              -->
  <!-- ====================================================== -->

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>


  <!-- ====================================================== -->
  <!-- Base frames                                            -->
  <!-- ====================================================== -->

  <link name="base_footprint"/>

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="20.0"/>

      <!-- Temporary inertia values -->
      <inertia
        ixx="1.0"
        ixy="0.0"
        ixz="0.0"
        iyy="2.5"
        iyz="0.0"
        izz="3.0"/>
    </inertial>

  </link>


  <!--
    Coordinate convention:
      X = forward
      Y = left
      Z = up

    base_link origin is defined at the geometric center
    of the SBG IMU.

    Measured SBG center height above ground:
      0.715 m
  -->

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.715" rpy="0 0 0"/>
  </joint>


  <!-- ====================================================== -->
  <!-- Wheel macro                                            -->
  <!-- ====================================================== -->

  <!--
    Four-wheel skid-steer configuration.

    IMPORTANT:
    The wheels do NOT steer around the Z axis.
    Steering is generated by differential velocity between
    the left and right wheel groups.
  -->

  <xacro:macro name="wheel" params="prefix x y">

    <link name="${prefix}_wheel_link">

      <visual>
        <!-- Cylinder axis converted to wheel axle direction -->
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="2.0"/>

        <!-- Approximate wheel inertia -->
        <inertia
          ixx="0.03"
          ixy="0.0"
          ixz="0.0"
          iyy="0.05"
          iyz="0.0"
          izz="0.03"/>
      </inertial>

    </link>


    <!--
      Wheel has ONLY rolling rotation.
      No steering joint is present.
    -->

    <joint name="${prefix}_wheel_joint" type="continuous">

      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>

      <origin
        xyz="${x} ${y} 0"
        rpy="0 0 0"/>

      <axis xyz="0 1 0"/>

    </joint>

  </xacro:macro>


  <!-- ====================================================== -->
  <!-- Four wheels                                            -->
  <!-- ====================================================== -->

  <!--
    wheelbase   = 1.07 m  -> +/- 0.535 m
    track_width = 0.55 m  -> +/- 0.275 m
  -->

  <xacro:wheel
    prefix="front_left"
    x="${wheelbase / 2.0}"
    y="${track_width / 2.0}"/>

  <xacro:wheel
    prefix="front_right"
    x="${wheelbase / 2.0}"
    y="${-track_width / 2.0}"/>

  <xacro:wheel
    prefix="rear_left"
    x="${-wheelbase / 2.0}"
    y="${track_width / 2.0}"/>

  <xacro:wheel
    prefix="rear_right"
    x="${-wheelbase / 2.0}"
    y="${-track_width / 2.0}"/>


  <!-- ====================================================== -->
  <!-- Front camera frame                                           -->
  <!-- ====================================================== -->

  <!--
    Temporary front camera transform.
    Camera position may be changed after final mechanical
    modification, so this transform is NOT final.
  -->

  <link name="front_camera_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.115 0.025"/>
      </geometry>
      <material name="black"/>
    </visual>

  </link>

  <joint name="front_camera_joint" type="fixed">

    <parent link="base_link"/>
    <child link="front_camera_link"/>

    <origin
      xyz="0.56 0 0.58"
      rpy="0 0.2618 0"/>

  </joint>


  <!-- ====================================================== -->
  <!-- Rear camera frame                                      -->
  <!-- ====================================================== -->

  <!--
    Temporary rear camera transform.
    Position and approximately 15 degree downward tilt
    are based on current mechanical installation.
  -->

  <link name="rear_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.115 0.025"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="rear_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_camera_link"/>
    <origin
      xyz="-0.79 0 0.58"
      rpy="0 -0.2618 3.14159"/>
  </joint>


  <!-- ====================================================== -->
  <!-- SBG IMU frame                                          -->
  <!-- ====================================================== -->

  <!--
    base_link is defined at the SBG IMU geometric center.
    Therefore imu_link is coincident with base_link.
  -->

  <link name="imu_link"/>

  <joint name="imu_joint" type="fixed">

    <parent link="base_link"/>
    <child link="imu_link"/>

    <origin
      xyz="0 0 0"
      rpy="0 0 0"/>

  </joint>


  <!-- ====================================================== -->
  <!-- SBG GNSS primary antenna ANT1                          -->
  <!-- ====================================================== -->

  <!--
    ANT1 / Primary GNSS antenna relative to the SBG center:

      X = +0.640 m forward
      Y =  0.000 m
      Z = +0.685 m upward

    ROS frame convention:
      X forward, Y left, Z up
  -->

  <link name="gps_link"/>

  <joint name="gps_joint" type="fixed">

    <parent link="base_link"/>
    <child link="gps_link"/>

    <origin
      xyz="0.640 0 0.685"
      rpy="0 0 0"/>

  </joint>


  <!-- ====================================================== -->
  <!-- Independent white GNSS antenna                         -->
  <!-- ====================================================== -->

  <!--
    Farm-ng white GNSS antenna relative to SBG/base_link:

      X = +0.480 m
      Y =  0.000 m
      Z = +0.645 m
  -->

  <link name="white_gnss_link"/>

  <joint name="white_gnss_joint" type="fixed">

    <parent link="base_link"/>
    <child link="white_gnss_link"/>

    <origin
      xyz="0.480 0 0.645"
      rpy="0 0 0"/>

  </joint>


  <!-- ====================================================== -->
  <!-- Velodyne VLP-16                                        -->
  <!-- ====================================================== -->

  <!--
    Velodyne center relative to SBG/base_link:

      X = +0.680 m
      Y = +0.150 m
      Z = +0.210 m

    Positive Y is robot left side.
  -->

  <link name="velodyne"/>

  <joint name="velodyne_joint" type="fixed">

    <parent link="base_link"/>
    <child link="velodyne"/>

    <origin
      xyz="0.680 0.150 0.210"
      rpy="0 0 0"/>

  </joint>



</robot>
